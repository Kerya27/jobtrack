# Copy to .env for local runs (uvicorn reads it automatically). In production set these
# as environment variables in the hosting dashboard instead.

# SQLite locally; PostgreSQL in production (Neon / Supabase connection string, postgres:// is fine).
DATABASE_URL=sqlite:///./jobtrack.db
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/jobtrack?sslmode=require

# Signs the session cookie. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# dev | prod. prod = secure cookies, /docs hidden, refuses to start with the default SECRET_KEY.
ENV=dev

# Set to false once your friends have signed up.
ALLOW_REGISTRATION=true

# Optional: URL-parser limit per user per hour (default 20).
# PARSE_RATE_LIMIT_PER_HOUR=20
